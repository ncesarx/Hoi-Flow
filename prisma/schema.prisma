generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum RoleCode {
  SUPER_ADMIN
  OWNER
  MANAGER
  ATTENDANT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  WHATSAPP
  MANUAL
}

enum NotificationChannel {
  WHATSAPP
}

enum OrderNotificationEvent {
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WhatsAppMessageType {
  TEXT
  UNSUPPORTED
}

enum WhatsAppConversationStatus {
  ACTIVE
  COMPLETED
  HANDED_OFF
  EXPIRED
}

enum WhatsAppIntent {
  START
  MENU
  ORDER
  STATUS
  HELP
  CANCEL
  UNKNOWN
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  legalName String?
  document  String?
  phone     String?
  timezone  String       @default("America/Sao_Paulo")
  currency  String       @default("BRL")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  units                   Unit[]
  users                   User[]
  categories              Category[]
  products                Product[]
  optionGroups            OptionGroup[]
  options                 Option[]
  auditLogs               AuditLog[]
  orders                  Order[]
  orderNotifications      OrderNotification[]
  whatsAppInboundMessages WhatsAppInboundMessage[]
  whatsAppConversations   WhatsAppConversation[]

  @@index([status])
}

model Unit {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  status      UnitStatus @default(ACTIVE)
  phone       String?
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  name         String
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(INVITED)
  role         RoleCode
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[] @relation("AuditActor")
  sessions  Session[]

  @@index([tenantId, status])
  @@index([tenantId, role])
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, active, position])
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  categoryId  String?
  name        String
  slug        String
  description String?
  basePrice   Decimal?      @db.Decimal(10, 2)
  status      ProductStatus @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  optionGroups ProductOptionGroup[]
  orderItems   OrderItem[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([categoryId])
}

model OptionGroup {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  slug          String
  selectionType SelectionType @default(SINGLE)
  minSelections Int           @default(0)
  maxSelections Int           @default(1)
  required      Boolean       @default(false)
  position      Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options  Option[]
  products ProductOptionGroup[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId, active, position])
}

model Option {
  id            String   @id @default(cuid())
  tenantId      String
  optionGroupId String
  name          String
  priceDelta    Decimal  @default(0) @db.Decimal(10, 2)
  position      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup       @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  orderItems  OrderItemOption[]

  @@unique([optionGroupId, name])
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model ProductOptionGroup {
  tenantId      String
  productId     String
  optionGroupId String
  position      Int    @default(0)

  product     Product     @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([productId, optionGroupId])
  @@index([tenantId])
  @@index([optionGroupId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model Order {
  id            String       @id @default(cuid())
  tenantId      String
  unitId        String?
  code          String
  channel       OrderChannel @default(MANUAL)
  status        OrderStatus  @default(NEW)
  customerName  String?
  customerPhone String?
  notes         String?
  total         Decimal      @default(0) @db.Decimal(10, 2)
  confirmedAt   DateTime?
  readyAt       DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit?               @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items         OrderItem[]
  notifications OrderNotification[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([unitId])
  @@index([customerPhone])
}

model OrderItem {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order             @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product Product?          @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  options OrderItemOption[]

  @@unique([id, tenantId])
  @@index([tenantId, orderId])
  @@index([productId])
}

model OrderItemOption {
  id          String   @id @default(cuid())
  tenantId    String
  orderItemId String
  optionId    String?
  optionName  String
  priceDelta  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  option    Option?   @relation(fields: [optionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, orderItemId])
  @@index([optionId])
}

model OrderNotification {
  id                String                     @id @default(cuid())
  tenantId          String
  orderId           String
  channel           NotificationChannel        @default(WHATSAPP)
  event             OrderNotificationEvent
  status            NotificationDeliveryStatus @default(PENDING)
  recipient         String
  payload           Json
  attempts          Int                        @default(0)
  availableAt       DateTime                   @default(now())
  sentAt            DateTime?
  lockedAt          DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([orderId, event])
  @@index([tenantId, status, availableAt])
  @@index([tenantId, orderId])
}

model WhatsAppInboundMessage {
  id                String              @id @default(cuid())
  tenantId          String
  externalMessageId String
  phoneNumberId     String
  sender            String
  type              WhatsAppMessageType
  text              String?
  receivedAt        DateTime
  payload           Json
  processedAt       DateTime?
  processingAt      DateTime?
  conversationId    String?
  createdAt         DateTime            @default(now())

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalMessageId])
  @@index([tenantId, processedAt, receivedAt])
  @@index([phoneNumberId])
}

model WhatsAppConversation {
  id            String                     @id @default(cuid())
  tenantId      String
  phoneNumberId String
  customerPhone String
  status        WhatsAppConversationStatus @default(ACTIVE)
  lastIntent    WhatsAppIntent?
  draft         Json
  lastMessageAt DateTime
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsAppInboundMessage[]

  @@unique([tenantId, customerPhone])
  @@index([tenantId, status, lastMessageAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
