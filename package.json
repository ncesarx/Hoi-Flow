    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "7.10.0",
    "tsx": "latest",
    "typescript": "latest"
